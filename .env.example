# ------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# --- Database (docker-compose defaults) ---------------------------
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_dev_password
POSTGRES_DB=marketplace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://marketplace:marketplace_dev_password@localhost:5432/marketplace?schema=public

# --- Redis (BullMQ queues + caching) ------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Meilisearch --------------------------------------------------
MEILI_PORT=7700
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key_change_me

# --- Auth (Phase 2) ----------------------------------------------
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000
# Key for encrypting TOTP secrets, ID numbers and vault files (AES-256-GCM).
# Required in production: openssl rand -base64 32. Never change it once data exists.
DATA_ENCRYPTION_KEY=
# Comma-separated emails promoted to SUPER_ADMIN once their address is confirmed.
SUPER_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Stripe Connect (Phase 2/5/6) --------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
# Country of the platform's Stripe account. Sellers in other countries are
# onboarded as cross-border "recipient" accounts (Stripe cross-border payouts).
STRIPE_PLATFORM_COUNTRY=US
PLATFORM_FEE_BPS=500

# --- Object storage: Cloudflare R2 or AWS S3 (Phase 7) -----------
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=marketplace-public
S3_BUCKET_VAULT=marketplace-vault
SIGNED_URL_TTL_SECONDS=300
# Development only: when S3 credentials are empty, files are written here.
LOCAL_STORAGE_DIR=.data/storage

# --- Email (Resend) ----------------------------------------------
RESEND_API_KEY=re_xxx
EMAIL_FROM=Marketplace <no-reply@example.com>

# --- Web app ------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
