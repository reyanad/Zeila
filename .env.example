# ------------------------------------------------------------------
# Copy to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# --- Database (docker-compose defaults) ---------------------------
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace_dev_password
POSTGRES_DB=marketplace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://marketplace:marketplace_dev_password@localhost:5432/marketplace?schema=public

# --- Redis (BullMQ queues + caching) ------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Meilisearch --------------------------------------------------
MEILI_PORT=7700
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key_change_me

# --- Worker (Phase 4) --------------------------------------------
# OpenAI-compatible embeddings endpoint for "similar listings" (optional).
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
# USD-based exchange rates, refreshed daily by the worker.
FX_RATES_URL=https://open.er-api.com/v6/latest/USD
WORKER_CONCURRENCY=4

# --- Auth (Phase 2) ----------------------------------------------
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000
# Key for encrypting TOTP secrets, ID numbers and vault files (AES-256-GCM).
# Required in production: openssl rand -base64 32. Never change it once data exists.
DATA_ENCRYPTION_KEY=
# Comma-separated emails promoted to SUPER_ADMIN once their address is confirmed.
SUPER_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Payments: Chapa -----------------------------------------------
# Secret key from the Chapa dashboard (Settings > API): CHASECK_TEST-... in test
# mode, CHASECK-... live. Leave empty to run without payments.
CHAPA_SECRET_KEY=
# Webhook secret from Settings > Webhooks; point the webhook URL at
# https://<your domain>/api/webhooks/chapa
CHAPA_WEBHOOK_SECRET=
CHAPA_API_URL=https://api.chapa.co/v1
PLATFORM_FEE_BPS=500

# --- Object storage: Cloudflare R2 or AWS S3 (Phase 7) -----------
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=marketplace-public
S3_BUCKET_VAULT=marketplace-vault
SIGNED_URL_TTL_SECONDS=300
# Development only: when S3 credentials are empty, files are written here.
LOCAL_STORAGE_DIR=.data/storage
# Public URL of the public bucket (e.g. an R2 custom domain). Empty = served via /api/assets.
PUBLIC_ASSET_BASE_URL=
# Largest digital product a seller can upload, in MB (streamed and encrypted).
DIGITAL_UPLOAD_MAX_MB=500

# --- Email (Resend) ----------------------------------------------
RESEND_API_KEY=re_xxx
EMAIL_FROM=Negadras <no-reply@example.com>

# --- Web app ------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=ETB

# --- Phase 8: messaging, notifications, disputes -----------------------------
# Socket.io gateway (apps/realtime). Leave NEXT_PUBLIC_REALTIME_URL empty to use
# polling instead of live updates.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
REALTIME_PORT=4001
# Brand name used in notification e-mails sent by the worker.
APP_NAME=Negadras

# --- Phase 11: mobile app ------------------------------------------------------
# Optional: Expo access token for sending push notifications (enhanced security
# in your Expo project). Push works without it unless that setting is on.
EXPO_ACCESS_TOKEN=
# The mobile app itself reads (at build time, from apps/mobile/.env):
#   EXPO_PUBLIC_API_URL=https://your-domain        (the web app's public URL)
#   EXPO_PUBLIC_EAS_PROJECT_ID=<uuid>             (from `eas init`; needed for push)
